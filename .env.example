# =============================================================================
# Public (browser-accessible) - exposed via NEXT_PUBLIC_ prefix
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Analytics - optional
# NEXT_PUBLIC_GA_ID: Google Analytics Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_ANALYTICS_ENDPOINT: custom endpoint to POST Web Vitals metrics
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""
# NEXT_PUBLIC_ENABLE_WEB_VITALS: force-enable Web Vitals reporting in dev ("true" | unset)
NEXT_PUBLIC_ENABLE_WEB_VITALS=""
# NEXT_PUBLIC_DEV_VITALS: dev-only floating overlay that shows live Core Web Vitals in the corner
# (LCP / INP / CLS / FCP / TTFB). Active only when NODE_ENV=development.
NEXT_PUBLIC_DEV_VITALS=""
NEXT_PUBLIC_DATA_BACKEND="cloudflare-d1"

# =============================================================================
# Server-only
# =============================================================================

# Cloudflare R2 (required for media uploads)
# Create an R2 API token with Object Read & Write for the bucket, then expose
# the bucket through a custom domain or r2.dev public URL.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
# Use a custom domain when available. Without a domain, use "/r2" to serve
# R2 objects through this Next.js app.
CLOUDFLARE_R2_PUBLIC_BASE_URL="/r2"

# Cloudflare D1 (data backend while still hosted on Vercel)
# CLOUDFLARE_D1_ACCOUNT_ID can be omitted if it is the same as CLOUDFLARE_R2_ACCOUNT_ID.
CLOUDFLARE_D1_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_D1_API_TOKEN=""
DATA_BACKEND="cloudflare-d1"

# Optional: Cloudflare CDN purge for Admin > Clear Cache.
# Token must have Zone.Cache Purge permission. This is separate from D1/R2 tokens.
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_CACHE_PURGE_TOKEN=""

# Admin auth - scrypt-hashed password + JWT secret + salt
ADMIN_PASSWORD_SCRYPT=""
ADMIN_PIN=""
JWT_SECRET=""
PASSWORD_SALT=""

# ISR revalidation token (protects /api/revalidate)
REVALIDATION_TOKEN=""

# AI providers
# GEMINI_API_KEY: Gemini (primary AI)
GEMINI_API_KEY=""
# GROQ_API_KEY: optional fallback for aiChatService + /api/chat/voice transcription
GROQ_API_KEY=""
# OPENROUTER_API_KEY: optional multi-provider AI fallback via OpenRouter
OPENROUTER_API_KEY=""
# GOOGLE_PAGESPEED_API_KEY: PageSpeed Insights fetcher (Lighthouse history script)
GOOGLE_PAGESPEED_API_KEY=""

# Telegram bot (guest reply + admin notifications)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_GROUP_ID=""
# TELEGRAM_FEEDBACK_THREAD_ID: message_thread_id (topic ID) di TELEGRAM_GROUP_ID
# untuk notif feedback dari exit-intent. Opsional - kalau kosong, notif masuk ke
# personal chat (TELEGRAM_CHAT_ID) seperti sebelumnya.
TELEGRAM_FEEDBACK_THREAD_ID=""

# =============================================================================
# Tooling / build-time flags
# =============================================================================
# ANALYZE=true -> open bundle analyzer during `npm run build`
ANALYZE=""
