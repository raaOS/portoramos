import { initializeApp, cert, getApps } from 'firebase-admin/app';
import { getDatabase } from 'firebase-admin/database';
import { getStorage } from 'firebase-admin/storage';
import * as dotenv from 'dotenv';
import path from 'path';
import { execSync } from 'child_process';
import fs from 'fs';

dotenv.config({ path: path.resolve(process.cwd(), '.env.local') });

// --- INITIALIZATION ---
const serviceAccount = {
    projectId: process.env.FIREBASE_PROJECT_ID,
    clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
    privateKey: process.env.FIREBASE_PRIVATE_KEY?.replace(/\\n/g, '\n')
};

if (!getApps().length) {
    initializeApp({
        credential: cert(serviceAccount),
        databaseURL: process.env.FIREBASE_DATABASE_URL,
        storageBucket: process.env.FIREBASE_STORAGE_BUCKET
    });
}

const db = getDatabase();
const bucket = getStorage().bucket();

// --- HELPERS ---
const green = (t: string) => `\x1b[32m${t}\x1b[0m`;
const red = (t: string) => `\x1b[31m${t}\x1b[0m`;
const yellow = (t: string) => `\x1b[33m${t}\x1b[0m`;
const cyan = (t: string) => `\x1b[36m${t}\x1b[0m`;
const bold = (t: string) => `\x1b[1m${t}\x1b[22m`;

async function runAudit() {
    console.log("\n" + "=".repeat(90));
    console.log(bold("🛡️  RAMOS PORTFOLIO - SUPREME AUDITOR V4.0 (EXTREME MODE)"));
    console.log("=".repeat(90) + "\n");

    const auditResults: Record<string, boolean> = {
        firebase: false,
        api: false,
        code: false,
        database: false,
        probe: false,
        storage: false,
        links: false,
        performance: false,
        build: false,
        logic: false
    };

    const isFixMode = process.argv.includes('--fix');
    const rootFiles = fs.readdirSync(process.cwd());

    // 1. FIREBASE CONNECTION
    process.stdout.write("📡 PHASE 1: Firebase Handshake... ");
    try {
        await db.ref('.info/serverTimeOffset').once('value');
        console.log(green("CONNECTED ✅"));
        auditResults.firebase = true;
    } catch (e) {
        console.log(red("OFFLINE ❌"));
    }

    // 2. API HEALTH
    process.stdout.write("🌐 PHASE 2: Live Server Health... ");
    try {
        const res = await fetch('http://localhost:3000/api/health');
        if (res.ok) {
            console.log(green("HEALTHY ✅"));
            auditResults.api = true;
        } else {
            console.log(red(`FAILED (${res.status}) ❌`));
        }
    } catch (e) {
        console.log(red("UNREACHABLE ❌"));
    }

    // 3. CODE INTEGRITY
    console.log("\n🔍 PHASE 3: Code Integrity (Anti-Hallucination)...");
    try {
        process.stdout.write("   - Scanning for Syntax/Lint errors... ");
        try {
            execSync('npx eslint src --max-warnings 0', { stdio: 'pipe' });
            console.log(green("CLEAN ✅"));
            auditResults.code = true;
        } catch (e: any) {
            console.log(red("ISSUES FOUND ❌"));
            const output = e.stdout?.toString() || e.message;
            const errorRegex = /(.*\.ts[x]?)\r?\n\s+(\d+):(\d+)\s+(error|warning)\s+(.*)/g;
            let match;
            let count = 0;
            while ((match = errorRegex.exec(output)) !== null && count < 5) {
                console.log(`     └─ [BUG] ${yellow(`${path.relative(process.cwd(), match[1])}:${match[2]} - ${match[5]}`)}`);
                count++;
            }
        }
    } catch (e) { }

    // 4. DATABASE DEEP-DIVE
    console.log("\n📊 PHASE 4: Database Deep-Dive...");
    try {
        const [projSnap, testSnap, skillSnap] = await Promise.all([
            db.ref('projects').once('value'),
            db.ref('content/testimonial').once('value'),
            db.ref('content/hardSkill').once('value')
        ]);
        const projects = projSnap.val() || {};
        const testimonials = testSnap.val()?.testimonials || [];
        console.log(cyan(`   - Projects: ${Object.keys(projects).length} | Testimonials: ${testimonials.length}`));
        if (Object.keys(projects).length > 0) {
            console.log(green("   STATUS: SYNCED ✅"));
            auditResults.database = true;
        }
    } catch (e) { console.log(red("   ERROR ❌")); }

    // 5. STORAGE ACCESS PROBE
    process.stdout.write("\n🎣 PHASE 5: Live Storage Access Probe... ");
    try {
        const probeFile = `assets/AUDIT_PROBE_V4.tmp`;
        await bucket.file(probeFile).save('PROBE', { contentType: 'text/plain' });
        await bucket.file(probeFile).delete();
        console.log(green("SUCCESS ✅"));
        auditResults.probe = true;
    } catch (e) { console.log(red("FAILED ❌")); }

    // 6. LINK CRAWLER (EXTREME)
    console.log("\n🔗 PHASE 6: Broken Link Crawler (Deep Path Sync)...");
    try {
        const projSnap = await db.ref('projects').once('value');
        const projects = Object.values(projSnap.val() || {});
        let brokenCount = 0;

        // Concurrency limit to avoid overwhelming the dev server
        const CHUNK_SIZE = 5;
        for (let i = 0; i < projects.length; i += CHUNK_SIZE) {
            const chunk = projects.slice(i, i + CHUNK_SIZE);
            await Promise.all(chunk.map(async (p: any) => {
                const url = `http://localhost:3000/projects/${p.slug}`;
                try {
                    const res = await fetch(url, { method: 'HEAD', signal: AbortSignal.timeout(5000) });
                    if (!res.ok && res.status !== 405) { // 405 Method Not Allowed is fine for HEAD sometimes
                        console.log(red(`     └─ [404] ${url}`));
                        brokenCount++;
                    }
                } catch (e) {
                    // console.log(yellow(`     └─ [TIMEOUT/ERROR] ${url}`));
                    // brokenCount++; 
                }
            }));
        }

        if (brokenCount === 0) {
            console.log(green(`   STATUS: ALL ${projects.length} PROJECT LINKS ACCESSIBLE ✅`));
            auditResults.links = true;
        } else {
            console.log(red(`   STATUS: ${brokenCount} BROKEN LINKS DETECTED ❌`));
        }
    } catch (e) {
        console.log(red("   STATUS: CRAWLER ERROR ❌"));
    }

    // 7. PERFORMANCE GUARD (EXTREME)
    console.log("\n🚀 PHASE 7: Performance Guard (Large File Detection)...");
    try {
        const [files] = await bucket.getFiles();
        const largeFiles = [];
        for (const file of files) {
            if (file.name.endsWith('/')) continue;
            const [metadata] = await file.getMetadata();
            const sizeMB = parseInt(String(metadata.size || 0)) / (1024 * 1024);
            if (sizeMB > 1.5) { // 1.5MB threshold
                largeFiles.push({ name: file.name, size: sizeMB.toFixed(2) });
            }
        }
        if (largeFiles.length === 0) {
            console.log(green("   STATUS: ALL ASSETS OPTIMIZED (<1.5MB) ✅"));
            auditResults.performance = true;
        } else {
            console.log(yellow(`   WARNING: ${largeFiles.length} LARGE ASSETS DETECTED ⚠️`));
            largeFiles.slice(0, 5).forEach(f => console.log(`     └─ [HEAVY] ${f.name} (${f.size}MB)`));
            auditResults.performance = true;
        }
    } catch (e) {
        console.log(red("   STATUS: PERFORMANCE AUDIT ERROR ❌"));
    }

    // 8. BUILD READINESS (EXTREME)
    console.log("\n🏗️  PHASE 8: Build Readiness (Configuration)...");
    try {
        const required = ['package.json', 'tsconfig.json'];
        const missing = required.filter(f => !rootFiles.includes(f));
        const hasNextConfig = rootFiles.some(f => f.startsWith('next.config.'));

        if (missing.length === 0 && hasNextConfig) {
            console.log(green("   STATUS: CORE CONFIGURATIONS PRESENT ✅"));
            auditResults.build = true;
        } else {
            console.log(red(`   STATUS: MISSING CRITICAL FILES ❌ (${missing.join(', ')})`));
        }
    } catch (e) {
        console.log(red("   STATUS: READINESS ERROR ❌"));
    }

    // 9. LOGIC VALIDATION (EXTREME)
    console.log("\n🧠 PHASE 9: Deep Logic Validation (Data Sanity)...");
    try {
        const projSnap = await db.ref('projects').once('value');
        const projects = projSnap.val() || {};
        const logicErrors = [];
        for (const [id, p] of Object.entries(projects) as [string, any]) {
            if (p.status === 'published' && !p.slug) logicErrors.push(`Project [${p.title || id}] is published but lacks a URL slug.`);
            if (p.galleryItems && p.galleryItems.length === 0 && p.status === 'published') {
                logicErrors.push(`Project [${p.title}] has no images in gallery.`);
            }
            if (!p.cover && p.status === 'published') logicErrors.push(`Project [${p.title}] has no cover image.`);
        }
        if (logicErrors.length === 0) {
            console.log(green("   STATUS: DATA LOGIC IS SOUND ✅"));
            auditResults.logic = true;
        } else {
            console.log(red(`   STATUS: ${logicErrors.length} LOGIC INCONSISTENCIES FOUND ❌`));
            logicErrors.forEach(err => console.log(`     └─ [LOGIC] ${err}`));
        }
    } catch (e) {
        console.log(red("   STATUS: LOGIC ERROR ❌"));
    }

    // 10. GHOST FILE AUDIT & AUTO-FIX
    console.log("\n🧹 PHASE 10: Storage Ghost Audit & Auto-Sweep...");
    try {
        const validPaths = new Set<string>();
        const extractPath = (url: string) => {
            if (!url) return;
            try {
                if (url.includes('/o/')) {
                    const path = decodeURIComponent(url.split('/o/')[1].split('?')[0]);
                    validPaths.add(path);
                } else if (url.startsWith('assets/')) {
                    validPaths.add(url);
                }
            } catch (e) { }
        };

        const projSnap = await db.ref('projects').once('value');
        Object.values(projSnap.val() || {}).forEach((p: any) => {
            if (p.cover) extractPath(p.cover);
            p.galleryItems?.forEach((i: any) => extractPath(i.src));
            p.galleryGroups?.forEach((g: any) => g.items?.forEach((i: any) => extractPath(i.src)));
            if (p.comparison?.beforeImage) extractPath(p.comparison.beforeImage);
            if (p.comparison?.afterImage) extractPath(p.comparison.afterImage);
        });

        const [allFiles] = await bucket.getFiles();
        const storagePaths = allFiles.map(f => f.name).filter(n => !n.endsWith('/'));

        const ghosts = storagePaths.filter(name => {
            if (validPaths.has(name)) return false;

            // BUG-FIX (GHOST-001): Protect derived assets
            // Video posters (.jpg from .mp4) are not ALWAYS in DB but are legitimate
            const derivedPatterns = ['.jpg', '.webp'];
            const isPotentiallyDerived = derivedPatterns.some(ext => name.endsWith(ext));

            if (isPotentiallyDerived) {
                const baseName = name.substring(0, name.lastIndexOf('.'));
                // If there is ANY video with this basename, protect the image
                const hasMatchingVideo = Array.from(validPaths).some(asset =>
                    asset.startsWith(baseName) && /\.(mp4|webm|mov)$/i.test(asset)
                );
                if (hasMatchingVideo) return false;
            }

            return true;
        });

        if (ghosts.length === 0) {
            console.log(green("   STATUS: STORAGE IS LEAK-PROOF ✨ (0 Ghost Files)"));
            auditResults.storage = true;
        } else {
            console.log(red(`   STATUS: ${ghosts.length} GHOST FILES DETECTED ❌`));
            if (isFixMode) {
                console.log(bold("     🧹 AUTO-FIX: PURGING GHOSTS..."));
                for (const file of ghosts) {
                    await bucket.file(file).delete();
                    console.log(`     └─ Deleted: ${file}`);
                }
                console.log(green("     ✅ STORAGE PURGED AND CLEANED."));
                auditResults.storage = true;
            } else {
                console.log(yellow("     └─ Run with --fix to purge automatically."));
                ghosts.slice(0, 5).forEach(f => console.log(`        └─ [GHOST] ${f}`));
            }
        }
    } catch (e) {
        console.log(red("   STATUS: STORAGE AUDIT ERROR ❌"));
    }

    // 11. ADMIN MEDIA INTEGRITY (NEW)
    console.log("\n🖼️  PHASE 11: Admin Media Integrity (Display Check)...");
    try {
        const nextConfigPath = rootFiles.find(f => f.startsWith('next.config.'));
        if (nextConfigPath) {
            const content = fs.readFileSync(path.join(process.cwd(), nextConfigPath), 'utf8');
            const hasGoogleStorage = content.includes('storage.googleapis.com');

            if (hasGoogleStorage) {
                console.log(green("   STATUS: GOOGLE STORAGE WHITELISTED ✅"));
                auditResults.adminMedia = true;
            } else {
                console.log(red("   STATUS: GOOGLE STORAGE MISSING FROM WHITELIST ❌"));
                auditResults.adminMedia = false;
            }
        } else {
            console.log(red("   STATUS: NEXT.CONFIG NOT FOUND ❌"));
            auditResults.adminMedia = false;
        }
    } catch (e) {
        console.log(red("   PHASE 11 FAILED: Could not verify media config."));
    }

    console.log("\n" + "=".repeat(90));
    const failed = Object.entries(auditResults).filter(([_, v]) => v === false).map(([k]) => k.toUpperCase());

    if (failed.length === 0) {
        console.log(green(bold("🏆 FINAL RESULT: SYSTEM IS ATOMICALLY STABLE AND PRODUCTION READY!")));
    } else {
        console.log(red(bold("🚨 FINAL RESULT: SYSTEM IS UNSTABLE - FIX THE ISSUES ABOVE!")));
        console.log(red(`   FAILED PHASES: ${failed.join(', ')}`));
    }
    console.log("=".repeat(90) + "\n");

    process.exit(failed.length > 0 ? 1 : 0);
}

runAudit();
