s/narasi-visual-moodboard.jpg\",\n        \"isActive\": true,\n        \"slug\": \"narasi-visual-moodboard\"\n      }\n    ],\n    \"availability\": {\n      \"status\": \"available\",\n      \"text\": \"Available for new Jobs\"\n    },\n    \"backgroundColor\": \"\",\n    \"textColor\": \"\",\n    \"ballColor\": \"#ffa799\",\n    \"capColor\": \"#ff8670\"\n  },\n  \"professional\": {\n    \"contacts\": {\n      \"email\": \"ra.920710@gmail.com\",\n      \"whatsapp\": \"08817472310\",\n      \"linkedin\": \"linkedin.com/in/ramos-design\"\n    },\n    \"motto\": {\n      \"badge\": \"Motto kerja\",\n      \"quote\": \"Desain adalah Hook: Bikin mereka berhenti scroll, lalu mengerti.\"\n    },\n    \"bio\": {\n      \"content\": \"Berpengalaman lebih dari 14 tahun di industri desain, saya berkembang sebagai Desainer Visual yang menggabungkan strategi dan estetika. Terbiasa bekerja di lingkungan korporasi maupun secara freelance, saya fokus pada Graphic Design, Branding, dan Visual Storytelling yang relevan dengan kebutuhan bisnis.\"\n    }\n  },\n  \"softSkills\": {\n    \"texts\": [\n      \"Kreativitas \u0026 Inovasi\",\n      \"Problem Solving\",\n      \"Visual Strategy\",\n      \"Adaptability\",\n      \"Timely Delivery\",\n      \"Tech Savvy\"\n    ],\n    \"descriptions\": [\n      \"Selalu punya ide fresh yang nggak pasaran.\",\n      \"Mengemas pesan brand jadi visual yang berani, konsisten, dan mudah diingat.\",\n      \"Jago cari solusi praktis buat masalah desain yang rumit.\",\n      \"Asik diajak kerjasama, nggak baperan kalau dikasih feedback.\",\n      \"Deadline adalah teman, bukan musuh. Selalu on time.\",\n      \"Cepat nyambung sama teknologi dan tren baru.\"\n    ]\n  },\n  \"designPhilosophy\": {\n    \"heading\": \"Philosophy of Design (Updated)\",\n    \"subheading\": \"Strategic Thinking Framework\",\n    \"steps\": [\n      {\n        \"number\": \"01\",\n        \"title\": \"Context \u0026 Purpose\",\n        \"desc\": \"Sebelum menyentuh ka