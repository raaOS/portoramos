e\":\"Advertising \u0026 Assets\",\"description\":\"Berbagai aset iklan digital untuk kampanye ini.\",\"items\":[{\"kind\":\"image\",\"src\":\"/assets/projects/identitas-monogram-hijau.jpg\",\"isActive\":true},{\"kind\":\"image\",\"src\":\"/assets/projects/tipografi-alam-kontras-tinggi.jpg\",\"isActive\":true}]},{\"id\":\"group-doc-1\",\"name\":\"Dokumentasi Visual\",\"description\":\"Hasil akhir desain dalam berbagai format.\",\"items\":[{\"kind\":\"image\",\"src\":\"/assets/projects/desain-sampul-hijau-tua.jpg\",\"isActive\":true},{\"kind\":\"image\",\"src\":\"/assets/projects/politik-pop-digital.jpg\",\"isActive\":true}]}],\"order\":1,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-03-04T18:15:36.780Z\"},\"cover\":{\"kind\":\"video\",\"src\":\"/assets/projects/kampanye-hadiah-digital-liburan.mp4\",\"poster\":\"/assets/projects/kampanye-hadiah-digital-liburan.jpg\",\"width\":1080,\"height\":1920},\"gallery\":[],\"ratio\":0.5625,\"otherProjects\":[{\"id\":\"gen-1766512146544-0\",\"slug\":\"manipulasi-foto-musik-alam\",\"title\":\"Manipulasi Foto Musik Alam\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Eksperimen surealis menggabungkan piringan hitam vinyl dengan elemen alam liar. Konsepnya visualisasi 'suara alam' secara harfiah.\",\"cover\":\"/assets/projects/manipulasi-foto-musik-alam.mp4\",\"coverWidth\":720,\"coverHeight\":900,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":33,\"shares\":5,\"allowComments\":true,\"status\":\"published\",\"role\":\"Digital Artist\",\"timeline\":\"2 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"challenge\":\"\",\"solution\":\"\",\"result\":\"\"},\"comparison\":{\"beforeImage\":\"/assets/projects/politik-pop-digital-cover.jpg\",\"beforeType\":\"image\",\"afterImage\":\"\",\"afterType\":\"video\"},\"initialCommentCount\":2,\"order\":2,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-02-24T21:46:20.600Z\"},{\"id\":\"gen-1766512146544-1\",\"slug\":\"kolase-lanskap-menanjak\",\"title\":\"Kolase Lanskap Menanjak\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Kolase digital yang mainin skala ekstrem. Tangan raksasa vs manusia kecil di lanskap musim gugur yang dramatis.\",\"cover\":\"/assets/projects/kolase-lanskap-menanjak.mp4\",\"coverWidth\":720,\"coverHeight\":900,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":37,\"shares\":1,\"allowComments\":true,\"status\":\"published\",\"role\":\"Visual Artist\",\"timeline\":\"Weekend Project\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"challenge\":\"\",\"solution\":\"\",\"result\":\"\"},\"order\":3,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-03-01T00:51:15.430Z\"},{\"id\":\"gen-1766512146544-2\",\"slug\":\"komposit-gerbang-neraka\",\"title\":\"Komposit Gerbang Neraka\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Visualisasi dark fantasy tentang perjalanan ke dunia bawah. Mood-nya gelap, gloomy, dengan gagak sebagai simbol mistis.\",\"cover\":\"/assets/projects/komposit-gerbang-neraka.mp4\",\"coverWidth\":720,\"coverHeight\":900,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":45,\"shares\":0,\"allowComments\":true,\"status\":\"published\",\"role\":\"Digital Artist\",\"timeline\":\"1 Night\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Terinspirasi dari film-film horor gothic klasik. Mencoba menangkap perasaan isolasi dan ketidakpastian saat melangkah ke tempat asing.\",\"process\":\"Pencahayaan sangat minim (low-key lighting). Hampir 70% canvas adalah shadow/hitam untuk membangun suspense.\",\"detail\":\"Siluet jembatan dan kabut tipis di kejauhan.\"},\"order\":4,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T17:40:25.513Z\"},{\"id\":\"gen-1766512146544-3\",\"slug\":\"politik-pop-digital\",\"title\":\"Politik Pop Digital\",\"client\":\"Personal Art\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Satire visual yang menggabungkan tokoh politik kaku dengan elemen bunga-bunga glitchy yang chaos. Tabrakan visual yang disengaja.\",\"cover\":\"/assets/projects/politik-pop-digital.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":22,\"shares\":0,\"allowComments\":true,\"status\":\"published\",\"role\":\"Digital Artist\",\"timeline\":\"5 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Mengkritik formalitas politik dengan estetika internet/glitch art. Bunga melambangkan topeng keindahan di atas realita yang keras.\",\"process\":\"Teknik datamoshing dan pixel sorting diaplikasikan ke foto asli, lalu di-overlay dengan ilustrasi bunga vintage.\",\"detail\":\"Karya ini sempat viral di komunitas Glitch Art karena kontras warnanya yang 'nyolot'.\"},\"comparison\":{\"beforeImage\":\"/assets/projects/comparisons/politik-pop-digital-before.png\",\"beforeType\":\"image\",\"afterImage\":\"/assets/projects/politik-pop-digital.jpg\",\"afterType\":\"image\"},\"order\":5,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-10T20:42:07.299Z\"},{\"id\":\"gen-1766512146544-4\",\"slug\":\"tempat-perlindungan-sneaker-surealis\",\"title\":\"Tempat Perlindungan Sneaker Surealis\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Imajinasi liar kalau sepatu itu bukan cuma alas kaki, tapi 'rumah' atau tempat berlindung. Manipulasi skala yang fun.\",\"cover\":\"/assets/projects/tempat-perlindungan-sneaker-surealis.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":32,\"shares\":2,\"allowComments\":true,\"status\":\"published\",\"role\":\"3D Artist\",\"timeline\":\"3 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Sneaker culture meets architectural dreams. Mengubah struktur sepatu sneakers modern jadi bangunan monumen di tengah alam.\",\"process\":\"Modeling dasar di Blender untuk referensi perspektif, lalu heavy photobashing di Photoshop untuk tekstur beton dan lumutnya.\",\"detail\":\"Tekstur tali sepatu yang berubah jadi kabel baja raksasa.\"},\"gallery\":[\"/assets/projects/tempat-perlindungan-sneaker-surealis-gallery.mp4\"],\"galleryItems\":[{\"kind\":\"video\",\"src\":\"/assets/projects/tempat-perlindungan-sneaker-surealis-gallery.mp4\",\"isActive\":true}],\"order\":6,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T17:42:53.880Z\"},{\"id\":\"gen-1766512146544-5\",\"slug\":\"overlay-bunga-barok-digital\",\"title\":\"Overlay Bunga Barok Digital\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Poster tipografi modern yang nabrakin gaya lukisan klasik Barok yang gelap dengan font sans-serif super clean.\",\"cover\":\"/assets/projects/overlay-bunga-barok-digital.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":15,\"shares\":1,\"allowComments\":true,\"status\":\"published\",\"role\":\"Graphic Designer\",\"timeline\":\"1 Day\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Eksplorasi tren desain 'Modern Nostalgia' yang lagi hype. Pengen bikin poster event fiktif yang elegan tapi edgy.\",\"challenge\":\"Gimana caranya naruh teks putih di atas background bunga yang super detail tanpa bikin pusing bacanya.\",\"solution\":\"Mainin kontras dan hierarchy ukuran font. Bunga dijadikan tekstur background, bukan focal point utama.\",\"impact\":\"Didesain untuk poster pameran seni atau cover majalah fashion indie.\"},\"order\":7,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T02:41:59.526Z\"},{\"id\":\"gen-1766512146544-7\",\"slug\":\"tipografi-alam-kontras-tinggi\",\"title\":\"Tipografi Alam Kontras Tinggi\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Eksperimen layout majalah. Hijau daun yang nendang banget warnanya ketemu sama whitespace dan tipografi Swiss Style.\",\"cover\":\"/assets/projects/tipografi-alam-kontras-tinggi.jpg\",\"coverWidth\":640,\"coverHeight\":640,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":43,\"shares\":1,\"allowComments\":true,\"status\":\"published\",\"role\":\"Graphic Designer\",\"timeline\":\"1 Day\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Latihan komposisi grid sistem. Mencoba memecah kekakuan grid dengan elemen organik (daun).\",\"challenge\":\"Menyeimbangkan area kosong (negative space) dengan area foto yang padat tekstur.\",\"solution\":\"Menggunakan tipografi bold sans-serif sebagai 'jangkar' visual biar mata gak lari kemana-mana.\",\"impact\":\"Cocok banget buat referensi layout lookbook fashion summer season.\"},\"order\":8,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-08T14:36:18.218Z\"},{\"id\":\"gen-1766512146544-6\",\"slug\":\"narasi-visual-moodboard\",\"title\":\"Narasi Visual \u0026 Moodboard\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Kumpulan potongan visual alias Moodboard untuk project film pendek sci-fi. Gabungan foto travel, tekstur, dan warna-warna dingin.\",\"cover\":\"/assets/projects/narasi-visual-moodboard.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":34,\"shares\":4,\"allowComments\":true,\"status\":\"published\",\"role\":\"Art Director\",\"timeline\":\"2 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Visual storytelling tanpa kata. Mengumpulkan fragmen-fragmen gambar untuk membangun 'dunia' dan 'rasa' sebelum syuting dimulai.\",\"process\":\"Kurasi ratusan foto, color correction biar tone-nya nyambung semua, lalu layouting gaya grid sinematik.\",\"detail\":\"Konsistensi palet warna biru-abu (cold tone) di setiap panel.\"},\"order\":9,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-08T14:36:18.218Z\"},{\"id\":\"gen-1766512146544-8\",\"slug\":\"desain-sampul-hijau-tua\",\"title\":\"Desain Sampul Hijau Tua\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Mockup cover buku/majalah indie. Nuansanya misterius, deep forest green dengan aksen merah beri.\",\"cover\":\"/assets/projects/desain-sampul-hijau-tua.jpg\",\"coverWidth\":640,\"coverHeight\":640,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":18,\"shares\":2,\"allowComments\":true,\"status\":\"published\",\"role\":\"Illustrator\",\"timeline\":\"1 Day\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Bikin desain cover untuk buku puisi fiksi bertema alam dan kehilangan.\",\"challenge\":\"Bikin visual yang 'sepi' tapi gak kosong.\",\"solution\":\"Pakai satu foto makro yang kuat sebagai background, tipografi disimpen kecil dan rapi di tengah biar elegan.\",\"impact\":\"Desain ini dirancang untuk menarik pembaca yang suka estetika minimalis dan melankolis.\"},\"order\":10,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T02:41:59.526Z\"},{\"id\":\"gen-1766512146544-10\",\"slug\":\"montase-bunga-cantik\",\"title\":\"Montase Bunga Cantik\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Animasi pendek looping (GIF style) yang super colorful. Bunga meledak keluar dari lampu lalu lintas. Aneh? Iya. Keren? Pasti.\",\"cover\":\"/assets/projects/montase-bunga-cantik.mp4\",\"coverWidth\":720,\"coverHeight\":900,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":42,\"shares\":5,\"allowComments\":true,\"status\":\"published\",\"role\":\"Motion Designer\",\"timeline\":\"3 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Project iseng buat konten TikTok/Reels. Pengen bikin sesuatu yang satisfying buat ditonton ulang-ulang.\",\"challenge\":\"Sinkronisasi gerakan 'ledakan' bunga biar kerasa natural tapi tetap kartunis.\",\"solution\":\"Kombinasi 3D particle system ringan dan layering 2D asset bunga.\",\"impact\":\"Potensial untuk aset social media brand fashion atau kosmetik yang playful.\"},\"order\":11,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-08T14:36:19.676Z\"},{\"id\":\"gen-1766512146544-9\",\"slug\":\"identitas-monogram-hijau\",\"title\":\"Identitas Monogram Hijau\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Explorasi logo monogram yang 'classy'. Menggabungkan inisial huruf dengan style kaligrafi modern di atas background tekstur organik.\",\"cover\":\"/assets/projects/identitas-monogram-hijau.jpg\",\"coverWidth\":640,\"coverHeight\":640,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":36,\"shares\":3,\"allowComments\":true,\"status\":\"published\",\"role\":\"Brand Designer\",\"timeline\":\"2 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Konsep branding untuk luxury boutique hotel yang eco-friendly.\",\"challenge\":\"Bikin logo yang kerasa mahal tapi tetap 'membumi' (nature-vibe).\",\"solution\":\"Pilih jenis huruf serif yang tajam, dipadukan warna hijau lumut gelap (forest green) biar kesan eksklusifnya dapet.\",\"impact\":\"Draft logo ini bisa dikembangkan jadi full brand identity kit.\"},\"order\":12,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-08T14:36:19.676Z\"},{\"id\":\"gen-1766512146544-11\",\"slug\":\"komposisi-kinetik-mengalir\",\"title\":\"Komposisi Kinetik Mengalir\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Poster olahraga yang dinamis. Background kuning ngejreng + efek motion blur buat nampilin kecepatan dan energi.\",\"cover\":\"/assets/projects/komposisi-kinetik-mengalir.mp4\",\"coverWidth\":960,\"coverHeight\":1198,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":42,\"shares\":4,\"allowComments\":true,\"status\":\"published\",\"role\":\"Art Director\",\"timeline\":\"1 Day\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Iklan sepatu lari urban. Target audiensnya anak muda kota yang aktif.\",\"challenge\":\"Visual harus teriak 'CEPAT' dan 'ENERGIK' dalam sekilas pandang.\",\"solution\":\"Pakai warna kuning safety (warning color) biar eye-catching, plus tipografi miring (italic) yang agresif.\",\"impact\":\"Desain high-impact yang cocok buat billboard atau poster jalanan.\"},\"order\":13,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T02:41:59.526Z\"},{\"id\":\"gen-1766512146544-12\",\"slug\":\"seni-poster-flatiron-neon\",\"title\":\"Seni Poster Flatiron Neon\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Gedung Flatiron New York tapi versi Cyberpunk/Vaporwave. Gradien pink-cyan nabrak gedung tua yang hitam putih.\",\"cover\":\"/assets/projects/seni-poster-flatiron-neon.mp4\",\"coverWidth\":720,\"coverHeight\":900,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":29,\"shares\":5,\"allowComments\":true,\"status\":\"published\",\"role\":\"Visual Designer\",\"timeline\":\"Weekend Project\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Old meets New. Arsitektur klasik yang 'dijajah' oleh estetika digital neon.\",\"process\":\"Seleksi gedung yang detail banget, lalu background diganti total dengan gradien vector.\",\"detail\":\"Efek glow pada tipografinya bikin teksnya serasa lampu neon beneran.\"},\"order\":14,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2025-12-27T02:41:59.526Z\"},{\"id\":\"gen-1766512146544-15\",\"slug\":\"pastoral-kawanan-berhalo\",\"title\":\"Pastoral Kawanan Berhalo\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Scene pedesaan yang aneh dan creepy. Hewan ternak punya 'halo' suci, melayang di sekitar figur misterius. Moodnya seperti lukisan klasik tapi twist horor.\",\"cover\":\"/assets/projects/pastoral-kawanan-berhalo.jpg\",\"coverWidth\":640,\"coverHeight\":798,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":21,\"shares\":3,\"allowComments\":true,\"status\":\"published\",\"role\":\"Concept Artist\",\"timeline\":\"4 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Religious iconography meets rural horror. Apa jadinya kalau hewan ternak dianggap suci dengan cara yang salah?\",\"process\":\"Digital painting di atas foto dasar (matte painting). Banyak main brush texture cat minyak biar kerasa 'old painting'.\",\"detail\":\"Cahaya halo yang pudar dan tidak sempurna.\"},\"order\":15,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-06T19:56:24.729Z\"},{\"id\":\"gen-1766512146544-16\",\"slug\":\"tipografi-mekar-gotik\",\"title\":\"Tipografi Mekar Gotik\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Tipografi yang 'tenggelam' di antara tanaman hutan gelap. Moody, atmospheric, dan sedikit gothic.\",\"cover\":\"/assets/projects/tipografi-mekar-gotik.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":19,\"shares\":4,\"allowComments\":true,\"status\":\"published\",\"role\":\"Graphic Designer\",\"timeline\":\"2 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Alam mengambil alih karya manusia. Teks (budaya) yang pelan-pelan tertutup semak belukar.\",\"process\":\"Teknik masking layer per layer. Sebagian huruf di depan daun, sebagian di belakang, buat efek kedalaman (depth).\",\"detail\":\"Shadow daun di atas huruf yang bikin efek realistis.\"},\"order\":16,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-06T19:56:24.729Z\"},{\"id\":\"gen-1766512146544-17\",\"slug\":\"kolase-dunia-ok-terfragmentasi\",\"title\":\"Kolase Dunia OK Terfragmentasi\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"video\"],\"description\":\"Kolase dadaisme modern. Potongan tubuh, globe, dan simbol tangan 'OK' yang random tapi estetik. Warna-warni pop art.\",\"cover\":\"/assets/projects/kolase-dunia-ok-terfragmentasi.mp4\",\"coverWidth\":960,\"coverHeight\":1198,\"autoplay\":true,\"muted\":true,\"loop\":true,\"playsInline\":true,\"likes\":37,\"shares\":0,\"allowComments\":true,\"status\":\"published\",\"role\":\"Visual Artist\",\"timeline\":\"1 Day\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Kekacauan informasi di era digital. Semuanya terpotong-potong dan dicampur aduk.\",\"process\":\"Metode 'Cut \u0026 Paste' digital. Sengaja dibuat kasar potongannya biar kerasa kayak zine punk.\",\"detail\":\"Komposisi diagonal yang bikin visualnya kerasa dinamis/gerak.\"},\"order\":17,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-06T19:56:24.729Z\"},{\"id\":\"gen-1766512146544-18\",\"slug\":\"efek-poster-bunga-berkerut\",\"title\":\"Efek Poster Bunga Berkerut\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Simulasi poster jalanan yang udah agak rusak/lecek (wheatpaste texture). Visualnya bunga cantik tapi teksturnya kasar.\",\"cover\":\"/assets/projects/efek-poster-bunga-berkerut.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":9,\"shares\":2,\"allowComments\":true,\"status\":\"published\",\"role\":\"Graphic Designer\",\"timeline\":\"3 Hours\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"commercial\",\"narrative\":{\"context\":\"Pengen bikin desain digital yang gak kerasa 'terlalu digital' atau licin.\",\"challenge\":\"Bikin efek kertas lecek yang realistis tanpa kelihatan maksa.\",\"solution\":\"Pakai displacement map dari foto kertas kusut asli, di-blend mode 'Multiply' di atas artwork.\",\"impact\":\"Memberikan kesan 'street' dan raw, cocok untuk brand streetwear atau event musik underground.\"},\"order\":18,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-06T19:56:24.729Z\"},{\"id\":\"gen-1766512146544-19\",\"slug\":\"belenggu-sandal-surgawi\",\"title\":\"Belenggu Sandal Surgawi\",\"client\":\"Personal Work\",\"year\":2025,\"tags\":[\"image\"],\"description\":\"Visual absurd: Sandal jepit tapi ada sayap malaikatnya, dirantai di atas tumpukan emas. Satire tentang komodifikasi hal suci.\",\"cover\":\"/assets/projects/belenggu-sandal-surgawi.jpg\",\"coverWidth\":640,\"coverHeight\":800,\"autoplay\":false,\"muted\":false,\"loop\":false,\"playsInline\":false,\"likes\":13,\"shares\":2,\"allowComments\":true,\"status\":\"published\",\"role\":\"Concept Artist\",\"timeline\":\"2 Days\",\"team\":\"Solo Project\",\"software\":[\"photoshop\"],\"type\":\"visual_art\",\"narrative\":{\"concept\":\"Kritik sosial tentang materialisme. 'Surgawi' yang terikat oleh kekayaan duniawi (emas).\",\"process\":\"Digital painting dengan referensi patung klasik Yunani.\",\"detail\":\"Kilauan emas yang kontras dengan tekstur batu rantai yang kasar.\"},\"order\":19,\"createdAt\":\"2025-12-23T17:49:06.544Z\",\"updatedAt\":\"2026-01-06T19:56:24.729Z\"},{\"id\":\"gen-1766512146544-20\",\"slug\":\"kaleidoskop-tipografi-gradien\",\"title\":\"Kaleidoskop Tipografi Gradien\",\"client\":\"Personal Work\",\"year\":2025,\"tags