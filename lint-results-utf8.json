desktopPreferences}\r\n                  onUpdate={(data) => handleUpdateAbout({ desktopPreferences: data })}\r\n                />\r\n              </div>\r\n            )}\r\n\r\n            {activeTab === 'dock' && (\r\n              <div className=\"space-y-8\">\r\n                <DockConfigForm\r\n                  data={aboutData?.dockConfig || {}}\r\n                  onUpdate={(data) => handleUpdateAbout({ dockConfig: data })}\r\n                />\r\n              </div>\r\n            )}\r\n\r\n\r\n\r\n            {activeTab === 'stickyNotes' && (\r\n              <div className=\"space-y-8\">\r\n                <StickyNotesManager />\r\n              </div>\r\n            )}\r\n\r\n            {activeTab === 'notifications' && (\r\n              <div className=\"space-y-8\">\r\n                <NotificationsManager\r\n                  notifications={aboutData?.islandNotifications || []}\r\n                  onUpdate={(data) => handleUpdateAbout({ islandNotifications: data })}\r\n                />\r\n              </div>\r\n            )}\r\n\r\n            {activeTab === 'sounds' && (\r\n              <div className=\"space-y-8\">\r\n                <SoundEffectsManager\r\n                  config={aboutData?.soundConfig || {}}\r\n                  onUpdate={(data) => handleUpdateAbout({ soundConfig: data })}\r\n                />\r\n              </div>\r\n            )}\r\n\r\n            {activeTab === 'archive' && (\r\n              <GalleryManager\r\n                projects={projects}\r\n              />\r\n            )}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </AdminLayout>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\USER\\Documents\\portfolio-shared\\src\\app\\admin\\about\\components\\AdminNoteEditor.tsx","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: The keyword 'interface' is reserved","line":4,"column":1}],"suppressedMessages":[],"errorCount":1,"fa